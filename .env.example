# EduOS AI — Environment Configuration
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.

# Supabase Project URL — format: https://<project-ref>.supabase.co
# Find it at: Supabase Dashboard → Your Project → Settings → API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon/public key (starts with eyJ... or sb_publishable_...)
# Find it at: Supabase Dashboard → Your Project → Settings → API → Project API keys → anon/public
# SUPABASE_ANON_KEY is also accepted as an alias.
SUPABASE_KEY=

# Groq API key (starts with gsk_...)
# Find it at: https://console.groq.com → API Keys
# Required for AI document extraction and Copilot LLM responses.
GROQ_API_KEY=

# JWT secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 random bytes. Never reuse across environments.
# Required for login / session tokens.
JWT_SECRET_KEY=

# ── Development only (never use in production) ───────────────────────────────
# Password for seed_dev_users.py development accounts (dev_admin, dev_teacher, etc.)
# Set locally before running: python seed_dev_users.py
# DEV_SEED_PASSWORD=
